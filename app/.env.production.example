# NHN 서버 배포용 환경변수 템플릿.
# 실제 값을 채운 뒤 서버의 app/.env.production 으로 저장한다 (git에는 절대 커밋하지 않음).

NODE_ENV=production

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role 키: 서버 전용, 절대 클라이언트/공개 저장소에 노출 금지
SUPABASE_SERVICE_ROLE_KEY=

# --- 토스페이먼츠 ---
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# --- 발주처 오픈API (조달청 나라장터/방위사업청 공용 서비스키, 한전, 한국도로공사) ---
NARA_SERVICE_KEY=
KEPCO_API_KEY=
EX_API_KEY=

# --- 관리자 수동 동기화 트리거용 시크릿 (임의의 긴 랜덤 문자열) ---
SYNC_TRIGGER_SECRET=
